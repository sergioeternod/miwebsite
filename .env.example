# Copia este archivo a ".env" (sin .example) y pon tus keys reales ahí.
# ".env" ya está en .gitignore — nunca se sube al repositorio.

# Requerida para el overlay de earnings (recommend --with-earnings, /earnings/{symbol})
# Consíguela gratis en https://finnhub.io
FINNHUB_API_KEY=

# Reservada para cuando se integre sentimiento de noticias (Alpha Vantage) — aún no usada por la app.
# Consíguela gratis en https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
